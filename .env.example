# ---------------------------------------------------------------------------
# Copy to .env (same folder as docker-compose.yml) and adjust.
# `docker compose` picks it up automatically. In Portainer, add these as
# stack environment variables instead.
# ---------------------------------------------------------------------------

# Image published by GitHub Actions -> ghcr.io/<user>/<repo>:latest
APP_IMAGE=ghcr.io/change-me/ps-form-designer:latest

# Host port the designer is reachable on
APP_PORT=8000

# Leave empty to auto-generate and persist a key on the data volume.
# Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Production default is 0 (off). Set to 1 only while troubleshooting.
DJANGO_DEBUG=0

# Comma separated. "*" accepts any host (handy on a LAN / behind a proxy).
DJANGO_ALLOWED_HOSTS=*

# e.g. https://designer.example.com,http://192.168.1.50:8000
DJANGO_CSRF_TRUSTED_ORIGINS=

# Set to 1 when running behind an https reverse proxy / Cloudflare tunnel
DJANGO_BEHIND_PROXY=0

DJANGO_CORS_ALLOW_ALL=1
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
TZ=UTC

# Optional Django admin account, created on first start
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=
